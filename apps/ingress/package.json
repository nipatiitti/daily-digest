{
  "name": "@digest/ingress",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "types": "wrangler types --strict-vars false",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy && node ../../scripts/sync-secrets.ts TELEGRAM_BOT_TOKEN TELEGRAM_WEBHOOK_SECRET && node ../../scripts/set-webhook.ts"
  },
  "dependencies": {
    "@digest/core": "workspace:*",
    "@digest/db": "workspace:*",
    "@digest/telegram": "workspace:*",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
