// Deployed by Workers Builds on every push to main (see DEPLOY.md).
// TELEGRAM_CHAT_IDS is the only value still to fill in.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "digest-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "hooks.dd.nipatiitti.fi", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digest",
      "database_id": "1111b792-3208-4f85-83e8-127a14c57038",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "vars": {
    // FILL IN (send /start to the bot): same list as apps/pipeline; only these chats can vote
    "TELEGRAM_CHAT_IDS": ""
  }
  // Secrets (set in the dashboard, never here): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
}
