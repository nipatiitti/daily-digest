// Deployed by Workers Builds from apps/pipeline on every push to main (see DEPLOY.md).
// Values marked FILL IN come from the one-time Cloudflare setup.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "digest-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": {
    // scheduler, daily digest (07:00 UTC)
    "crons": ["* * * * *", "0 7 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digest",
      // FILL IN: `wrangler d1 create digest` prints it
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "FETCH_Q", "queue": "fetch-q" }],
    "consumers": [
      {
        "queue": "fetch-q",
        "max_batch_size": 10,
        "max_concurrency": 5,
        "max_retries": 2,
        "dead_letter_queue": "fetch-dlq"
      }
    ]
  },
  "workflows": [{ "binding": "DIGEST", "name": "digest", "class_name": "Digest" }],
  "vars": {
    // FILL IN: comma-separated Telegram chat IDs that receive the digest (send /start to the bot to get yours)
    "TELEGRAM_CHAT_IDS": ""
  }
  // Secrets (set in the dashboard, never here): TELEGRAM_BOT_TOKEN
}
