{
  "name": "daily-digest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check . && pnpm -r --parallel typecheck",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "deploy:pipeline": "pnpm check && pnpm --filter @digest/pipeline run deploy",
    "deploy:ingress": "pnpm check && pnpm --filter @digest/ingress run deploy",
    "deploy:dashboard": "pnpm check && pnpm --filter @digest/dashboard run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "typescript": "^6.0.3"
  }
}
